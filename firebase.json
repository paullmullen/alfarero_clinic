{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/dailyEmailCloudFunctions/**"
    ],
    "rewrites": [
      {
        "source": "/getOpsObservationsFeed",
        "function": {
          "functionId": "getOpsObservationsFeed",
          "codebase": "api"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "dailyEmailCloudFunctions",
      "codebase": "daily"
    },
    {
      "source": "functions",
      "codebase": "api"
    },
    {
      "source": "scannerCloudFunctions",
      "codebase": "scanner"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "auth": {
      "port": 9099
    }
  }
}
