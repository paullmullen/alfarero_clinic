rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve existing app access while making derived analytics server-only.
    match /{collection}/{document=**} {
      allow read, write: if !(collection in [
        'analytics_records', 'analytics_daily', 'analytics_dirty_days',
        'analytics_ingestion', 'analytics_reports'
      ]);
    }
  }
}
